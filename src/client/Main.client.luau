--!strict
-- The Cannibal Family - client entry point.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

ReplicatedStorage:WaitForChild("Shared")
require(ReplicatedStorage.Shared.Net)

local Controllers = script.Parent:WaitForChild("Controllers")
local UI = script.Parent:WaitForChild("UI")

for _, coreGui in { Enum.CoreGuiType.Backpack, Enum.CoreGuiType.PlayerList, Enum.CoreGuiType.Health, Enum.CoreGuiType.EmotesMenu } do
	pcall(function()
		StarterGui:SetCoreGuiEnabled(coreGui, false)
	end)
end

local MeshLibrary = require(Controllers.MeshLibrary)
local Audio = require(Controllers.Audio)
local CameraController = require(Controllers.CameraController)
local Movement = require(Controllers.Movement)
local Effects = require(Controllers.Effects)
local Viewmodel = require(Controllers.Viewmodel)
local HidingView = require(Controllers.HidingView)
local KeyframeAnimator = require(Controllers.KeyframeAnimator)
local CannibalSkins = require(Controllers.CannibalSkins)
local MonsterForm = require(Controllers.MonsterForm)
local ChaseFX = require(Controllers.ChaseFX)
local Throwing = require(Controllers.Throwing)
local Scares = require(Controllers.Scares)
local Cutscenes = require(Controllers.Cutscenes)
local Prompts = require(UI.Prompts)
local HUD = require(UI.HUD)
local Inventory = require(UI.Inventory)
local Notes = require(UI.Notes)
local Crafting = require(UI.Crafting)
local Struggle = require(UI.Struggle)
local Death = require(UI.Death)
local Ending = require(UI.Ending)
local Menu = require(UI.Menu)
local SettingsPage = require(UI.SettingsPage)
local TouchControls = require(UI.TouchControls)

MeshLibrary.init()
Audio.init()
CameraController.init()
Movement.init()
Effects.init()
Viewmodel.init()
HidingView.init()
KeyframeAnimator.init()
CannibalSkins.init()
MonsterForm.init()
ChaseFX.init()
Throwing.init()
Scares.init()
Prompts.init()
HUD.init()
Inventory.init()
Notes.init()
Crafting.init()
Struggle.init()
Cutscenes.init()
Death.init()
Ending.init()
SettingsPage.init() -- applies the saved settings once the profile loads
TouchControls.init()
require(UI.Lobby).run() -- applies the difficulty; in the lobby it holds here until the game starts
Menu.init()
