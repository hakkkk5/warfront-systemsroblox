	------------------------------------------------------------ the escape, and things to try in the rooms
	["Find the deadbolt key (upstairs)"] = "Trouver la clé du verrou (à l'étage)",
	["Cut the alarm wire on the front door"] = "Couper le fil de l'alarme sur la porte d'entrée",
	["Cut the alarm wire"] = "Couper le fil de l'alarme",
	["Cut the wire"] = "Couper le fil",
	["Door alarm"] = "Alarme de porte",
	["Deadbolt Key"] = "Clé du verrou",
	["A small steel key on a loop of twine. The front door's second lock."] = "Une petite clé en acier au bout d'une ficelle. Le deuxième verrou de la porte d'entrée.",
	["There's a deadbolt too. The key must be somewhere upstairs."] = "Il y a aussi un verrou. La clé doit être quelque part à l'étage.",
	["A wire runs from the handle to a bell over the door. Open it now and they'll all hear. Cut it first."] = "Un fil relie la poignée à une cloche au-dessus de la porte. Si j'ouvre maintenant, ils entendront tous. Il faut d'abord le couper.",
	["I need something sharp to cut it."] = "Il me faut quelque chose de tranchant pour le couper.",
	["The deadbolt key. One more lock gone."] = "La clé du verrou. Encore une serrure de moins.",
	["Got it. Quietly... quietly."] = "C'est fait. Doucement... doucement.",
	["Piano"] = "Piano",
	["Play a few notes"] = "Jouer quelques notes",
	["The piano plays one more note after you stop."] = "Le piano joue une note de plus après que tu t'es arrêté.",
	["Out of tune. Except for one key, which plays perfectly."] = "Désaccordé. Sauf une touche, qui sonne parfaitement.",
	["Television"] = "Télévision",
	["Thump the TV"] = "Taper sur la télé",
	["The static makes a face for a second. Then it's static again."] = "La neige forme un visage une seconde. Puis redevient de la neige.",
	["For a moment the channel shows this room. You aren't in it."] = "Un instant, la chaîne montre cette pièce. Tu n'y es pas.",
	["Look at the plates"] = "Regarder les assiettes",
