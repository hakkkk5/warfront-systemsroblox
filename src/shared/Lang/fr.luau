	["Guests"] = "Invités",
	["A young couple outside a brand new farmhouse. A sign on the porch: HOLLOW MEATS - FAMILY BUTCHERS."] = "Un jeune couple devant une ferme toute neuve. Un panneau sur le porche : HOLLOW MEATS - BOUCHERS DE FAMILLE.",
	["Two little boys in matching aprons, holding a cleaver between them. They're both grinning."] = "Deux petits garçons en tabliers assortis tiennent un hachoir entre eux. Ils sourient tous les deux.",
	["A ribbon across the plant gates. The whole town turned out. Everyone's smiling."] = "Un ruban devant les grilles de l'usine. Toute la ville est venue. Tout le monde sourit.",
	["Snow up to the windows. The shelves in the store behind them are completely empty."] = "De la neige jusqu'aux fenêtres. Les rayons du magasin derrière eux sont complètement vides.",
	["A long table, every seat filled. Only the family is looking at the camera."] = "Une longue table, toutes les places prises. Seule la famille regarde l'objectif.",
	["A man in a county jacket with a clipboard, at the plant door. Someone has drawn an X over his face."] = "Un homme en veste du comté, un bloc-notes à la main, à la porte de l'usine. Quelqu'un a tracé une croix sur son visage.",
	["The plant gates chained shut. A notice: CLOSED BY ORDER OF THE COUNTY. The gates are open in every later photo."] = "Les grilles de l'usine fermées par une chaîne. Un avis : FERMÉ SUR ORDRE DU COMTÉ. Les grilles sont ouvertes sur toutes les photos suivantes.",
	["A woman in a church dress holding a pie. The filling is very, very red."] = "Une femme en robe du dimanche tient une tarte. La garniture est très, très rouge.",
	["Miners at the shaft head, black with coal. One of them is circled. Under it: 'kept us fed all winter'."] = "Des mineurs à l'entrée du puits, noirs de charbon. L'un d'eux est entouré. En dessous : « nous a nourris tout l'hiver ».",
	["Main Street, the church at the end of it. Not one person in the street. Not one car."] = "Main Street, l'église au bout. Personne dans la rue. Pas une voiture.",
	["The whole family in their masks, posed like a school picture. The smallest mask is on a child."] = "Toute la famille masquée, posant comme pour une photo de classe. Le plus petit masque est porté par un enfant.",
	["Dozens of photos of strangers, pinned to a board. Some faces have a red tick. Most of them do."] = "Des dizaines de photos d'inconnus épinglées sur un panneau. Certains visages ont une coche rouge. La plupart.",
	["A blurry photo through a car windscreen on Hollow Road, in the rain. It's your car. It was taken before the crash."] = "Une photo floue prise à travers un pare-brise sur Hollow Road, sous la pluie. C'est ta voiture. Elle a été prise avant l'accident.",

	------------------------------------------------------------ the story
	["Get them out. The house isn't far."] = "Sors-les de là. La maison n'est pas loin.",
	["Okay, I'm officially starving. How far's the McDonald's?"] = "Bon, je meurs de faim. C'est loin, le McDo ?",
	["Sign said twelve miles. Twenty minutes, tops."] = "Le panneau disait vingt kilomètres. Vingt minutes, maximum.",
	["Twenty minutes? In THIS storm? We're gonna die out here for nuggets."] = "Vingt minutes ? Avec CETTE tempête ? On va mourir ici pour des nuggets.",
	["Is that... somebody standing on the ridge? With a-"] = "C'est... quelqu'un debout sur la crête ? Avec un-",
	["…guys…? Is everyone okay…?"] = "…les gars…? Tout le monde va bien…?",
	["Hello?! Anybody hurt in there?!"] = "Ohé ?! Il y a des blessés là-dedans ?!",
	["Easy… easy now. We've got you."] = "Doucement… doucement. On vous tient.",
	["Shh… you're safe now."] = "Chut… vous êtes en sécurité maintenant.",
	["That pine's taken out three cars this year. Terrible bend in the road."] = "Ce pin a eu trois voitures cette année. Terrible virage.",
	["There you are. You gave us quite a scare."] = "Te voilà. Tu nous as fait une sacrée peur.",
	["Wh… where am I…?"] = "Où… où je suis…?",
	["Our place. Your car wrapped itself around a pine on Hollow Road."] = "Chez nous. Ta voiture s'est enroulée autour d'un pin sur Hollow Road.",
	["Your friends…? Sweetheart, you were the only one in that car."] = "Tes amis…? Mon chou, tu étais seul dans cette voiture.",
	["Your friends are fine. A few bruises, that's all."] = "Tes amis vont bien. Quelques bleus, c'est tout.",
	["No… no, they were right there next to me…"] = "Non… non, ils étaient juste à côté de moi…",
	["Thank you… both of you."] = "Merci… à tous les deux.",
	["Phone line's down with the storm. We'll drive you into town come morning."] = "La ligne est coupée avec la tempête. On te conduira en ville demain matin.",
	["Make yourself at home. There's stew on the stove."] = "Fais comme chez toi. Il y a du ragoût sur le feu.",
	["Just… stay out of the basement. It floods."] = "Simplement… n'entre pas au sous-sol. Il est inondé.",
	["Come on, Michel. Let our guest rest."] = "Viens, Michel. Laissons notre invité se reposer.",
	["Come on, Michel. Let our guests rest."] = "Viens, Michel. Laissons nos invités se reposer.",
	["...was someone at the window?"] = "...il y avait quelqu'un à la fenêtre ?",
	["Where am I...? Everyone's alright... I think."] = "Où suis-je...? Tout le monde va bien... je crois.",
	["Make yourself at home. We don't get many visitors out here."] = "Fais comme chez toi. On ne reçoit pas beaucoup de visite par ici.",
	["Mind the basement. It floods when it rains like this."] = "Attention au sous-sol. Il est inondé quand il pleut comme ça.",
	["Don't mind the smell. We butcher our own meat out here."] = "Ne fais pas attention à l'odeur. On découpe notre propre viande ici.",
	["Phone line's down. The storm took it. We'll drive you to town at first light."] = "La ligne est coupée. La tempête l'a emportée. On te conduira en ville au petit jour.",
	["Storm'll pass by morning. Always does."] = "La tempête sera passée demain matin. Comme toujours.",
	["Your friends are right behind us. Don't you worry."] = "Tes amis sont juste derrière nous. Ne t'inquiète pas.",
	["You really should be resting."] = "Tu devrais vraiment te reposer.",
	["You're wandering an awful lot for someone with a concussion."] = "Tu te promènes beaucoup pour quelqu'un qui a une commotion.",
	["Hungry yet? You look... hungry."] = "Tu as faim ? Tu as l'air... d'avoir faim.",
	["Feeling better? There's stew on the stove. Help yourself, it's fresh."] = "Ça va mieux ? Il y a du ragoût sur le feu. Sers-toi, il est frais.",
	["Funny. Folks who snoop around usually end up staying a while longer."] = "C'est drôle. Ceux qui fouinent finissent souvent par rester plus longtemps.",
	["Jason doesn't like guests going through his things."] = "Jason n'aime pas que les invités fouillent dans ses affaires.",
	["Michel's a light sleeper. Try not to open too many doors."] = "Michel a le sommeil léger. Évite d'ouvrir trop de portes.",
	["Find anything interesting up there?"] = "Tu as trouvé quelque chose d'intéressant là-haut ?",
	["That hatch in the kitchen? Just the cellar. Nothing down there but meat."] = "Cette trappe dans la cuisine ? Juste la cave. Il n'y a que de la viande en bas.",
	["Since you're up and about... would you lend us a hand before supper?"] = "Puisque tu es debout... tu veux bien nous donner un coup de main avant le souper ?",
	["Good. You're learning how we do things here."] = "Bien. Tu apprends comment on fait les choses ici.",
	["You've been busy."] = "Tu n'as pas chômé.",
	["Supper's ready! Everybody to the dining room. Now."] = "Le souper est prêt ! Tout le monde à la salle à manger. Maintenant.",
	["Sit down. You'll feel much better once you've eaten."] = "Assieds-toi. Tu te sentiras bien mieux une fois que tu auras mangé.",
	["Mm... it's good. Sweet. Almost like pork... what kind of meat is this?"] = "Mm... c'est bon. Sucré. Presque comme du porc... c'est quelle viande ?",
	["Say hello to everybody, sweetheart. You're our guests now."] = "Dis bonjour à tout le monde, mon chou. Vous êtes nos invités maintenant.",
	["They found it, Jason."] = "Ils l'ont trouvé, Jason.",
	["...You found the teeth, didn't you."] = "...Tu as trouvé les dents, hein.",
	["They know. The front door's padlocked and nailed shut... I need the key and something to pry it open. MOVE!"] = "Ils savent. La porte d'entrée est cadenassée et clouée... il me faut la clé et de quoi l'ouvrir. BOUGE !",
	["Jason has his beer."] = "Jason a sa bière.",
	["Michel has his oil."] = "Michel a son huile.",
	["I've already got one for him."] = "J'en ai déjà une pour lui.",
	["I've got the cup."] = "J'ai la tasse.",
	["It's gone cold."] = "Il a refroidi.",
	["Grandma's asleep in her chair."] = "Mamie dort dans son fauteuil.",
	["Grandma's room is at the top of the back stairs. She takes it with a lot of sugar."] = "La chambre de Mamie est en haut de l'escalier de service. Elle le prend très sucré.",
	["Grandma...? Her skin is like paper. She's been dead for YEARS."] = "Mamie...? Sa peau est comme du papier. Elle est morte depuis des ANNÉES.",
	["She hasn't moved. She isn't going to."] = "Elle n'a pas bougé. Elle ne bougera pas.",
	["Michel wants the good plates from the china hutch."] = "Michel veut les belles assiettes du vaisselier.",
	["The table is already set."] = "La table est déjà mise.",
	["Six places. Michel set out a bib at the head of the table... and a cleaver."] = "Six couverts. Michel a mis un bavoir en bout de table... et un hachoir.",
	["Six plates. There are only two of them... who are the other places for?"] = "Six assiettes. Ils ne sont que deux... pour qui sont les autres places ?",
	["Jason wants it kept going. There's a log basket by the wall."] = "Jason veut qu'il ne s'éteigne pas. Il y a un panier à bûches contre le mur.",
	["The fire's roaring."] = "Le feu ronfle.",
	["There's something in the ashes. A belt buckle. And a tooth."] = "Il y a quelque chose dans les cendres. Une boucle de ceinture. Et une dent.",
	["Just before the curtain closed... something was standing in the yard. Watching."] = "Juste avant que le rideau se ferme... quelque chose se tenait dans la cour. Et regardait.",
	["A washing line, strung between the rafters."] = "Une corde à linge, tendue entre les chevrons.",
	["There's a shape under the next sheet along. Standing very still."] = "Il y a une forme sous le drap d'à côté. Parfaitement immobile.",
	["The mattress is new. The stain underneath it isn't."] = "Le matelas est neuf. La tache en dessous, non.",
	["Grandpa's voice. Michel hums along to it from the kitchen."] = "La voix de Papi. Michel fredonne avec lui depuis la cuisine.",
	["The needle's stuck in the last groove."] = "L'aiguille est coincée dans le dernier sillon.",
	["[A hymn, scratched and slow. Then a man's voice over it:]"] = "[Un cantique, rayé et lent. Puis une voix d'homme par-dessus :]",
	["\"...Sunday supper, Pinecrest church. Bring the whole family. Bring a guest.\""] = "\"...Souper du dimanche, église de Pinecrest. Venez en famille. Amenez un invité.\"",
	["...storm over the county tonight... state police are asking anyone on Hollow Road..."] = "...tempête sur le comté ce soir... la police d'État demande à toute personne sur Hollow Road...",
	["...to stay in their vehicles. Do NOT accept assistance from-  [click]"] = "...de rester dans son véhicule. N'acceptez AUCUNE aide de-  [clic]",
	["Just static."] = "Juste des grésillements.",
	["Just static now."] = "Plus que des grésillements.",
	["Someone turned the dial back. Nobody's in here."] = "Quelqu'un a remis le bouton en arrière. Il n'y a personne.",
	["The pattern's traced around a person. Lying down. Arms out."] = "Le patron est tracé autour d'une personne. Allongée. Bras écartés.",
	["Lamp oil... it smells like the cellar. Michel wanted this."] = "De l'huile à lampe... ça sent la cave. Michel en voulait.",
	["Bless you. The lamps in the cellar drink it up... we keep them lit for the guests."] = "Merci, mon petit. Les lampes de la cave en boivent... on les garde allumées pour les invités.",
	["The can's full."] = "Le bidon est plein.",
	["An album. Every page a different guest. The last page is blank... waiting."] = "Un album. Un invité différent à chaque page. La dernière page est vide... elle attend.",
	["Toys... and a drawing, folded up very small."] = "Des jouets... et un dessin, plié tout petit.",
	["It reads %d o'clock. It's ticking again."] = "Elle indique %d heures. Elle fait de nouveau tic-tac.",
	["The clock now reads %d o'clock."] = "L'horloge indique maintenant %d heures.",
	["Empty. The water is pink."] = "Vide. L'eau est rose.",
	["Something's at the bottom of the tub. A wedding ring."] = "Il y a quelque chose au fond de la baignoire. Une alliance.",
	["Empty, except for pill bottles with other people's names."] = "Vide, à part des flacons de médicaments au nom d'autres personnes.",
	["Pill bottles with strangers' names on them... and a little brass key on a ribbon."] = "Des flacons au nom d'inconnus... et une petite clé en laiton au bout d'un ruban.",
	["Locked. A tiny brass keyhole."] = "Verrouillé. Une minuscule serrure en laiton.",
	["A drawer just slid out of the base. There's a VHS tape inside. It says 'GUESTS'."] = "Un tiroir vient de sortir du socle. Il y a une cassette VHS dedans. Elle s'intitule « INVITÉS ».",
	["There's a tape deck under the TV. Nothing in it."] = "Il y a un magnétoscope sous la télé. Rien dedans.",
	["[Static. Then this room, years ago. A family of four on the sofa, smiling at the camera.]"] = "[De la neige. Puis cette pièce, il y a des années. Une famille de quatre sur le canapé, souriant à la caméra.]",
	["[The father laughs. Behind him, Jason walks past with the cleaver.]"] = "[Le père rit. Derrière lui, Jason passe avec le hachoir.]",
	["[The picture jumps. The same sofa. Empty. A stain on the cushion.]"] = "[L'image saute. Le même canapé. Vide. Une tache sur le coussin.]",
	["They film it. They keep them like home movies."] = "Ils filment tout. Ils les gardent comme des films de famille.",
	["Hello? Hello, is this the police—"] = "Allô ? Allô, c'est la police—",
	["The line's coming from inside the house."] = "L'appel vient de l'intérieur de la maison.",
	["(slow breathing)"] = "(respiration lente)",
	["...(slow breathing)... we can hear you too."] = "...(respiration lente)... nous aussi, on t'entend.",
	["Breaker %d of 3. Something's humming."] = "Disjoncteur %d sur 3. Quelque chose bourdonne.",
	["The lights are back... and they heard that."] = "La lumière revient... et ils ont entendu.",
	["The lights die again. Someone's at the breaker..."] = "La lumière s'éteint encore. Quelqu'un est au disjoncteur...",
	["Click. Nothing. They cut the power."] = "Clic. Rien. Ils ont coupé le courant.",
	["Teeth. Human teeth. Some still have fillings."] = "Des dents. Des dents humaines. Certaines ont encore des plombages.",
	["Those aren't pork chops. Those packages have NAMES on them."] = "Ce ne sont pas des côtelettes de porc. Il y a des NOMS sur ces paquets.",
	["These are the faces from the gas station board... all crossed out."] = "Ce sont les visages du tableau de la station-service... tous barrés.",
	["Everyone's face is scratched out but theirs... is that MY car?"] = "Tous les visages sont rayés sauf les leurs... c'est MA voiture ?",
	["Six people. On this road. And they 'help travellers'..."] = "Six personnes. Sur cette route. Et eux « aident les voyageurs »...",
	["Beer... and behind it, something wrapped in butcher's paper. It's still warm."] = "De la bière... et derrière, quelque chose emballé dans du papier de boucher. C'est encore tiède.",
	["A deputy's jacket. Soaked in blood."] = "Une veste d'adjoint du shérif. Trempée de sang.",
	["Whatever they're hiding is under that hatch... and Jason keeps a ring of keys on his belt."] = "Ce qu'ils cachent est sous cette trappe... et Jason garde un trousseau de clés à sa ceinture.",
	["'Don't go in the basement.' Right. Something scratched this from the inside."] = "« Ne va pas au sous-sol. » D'accord. Quelque chose a griffé ça de l'intérieur.",
	["...I know what this is. I'm going to be sick."] = "...Je sais ce que c'est. Je vais vomir.",
	["The padlock key... the front door."] = "La clé du cadenas... la porte d'entrée.",
	["A crowbar. The boards on the front door..."] = "Un pied-de-biche. Les planches de la porte d'entrée...",
	["Bolt cutters. That padlock on the kitchen hatch..."] = "Un coupe-boulons. Ce cadenas sur la trappe de la cuisine...",
	["A heavy chain and padlock hold it shut. I need the key."] = "Une lourde chaîne et un cadenas la ferment. Il me faut la clé.",
	["They nailed it shut from inside. I need something to pry these boards off."] = "Ils l'ont clouée de l'intérieur. Il me faut de quoi arracher ces planches.",
	["Too loud... they heard that. Now the padlock key."] = "Trop fort... ils ont entendu. Maintenant, la clé du cadenas.",
	["Too loud... they heard that. The padlock, NOW!"] = "Trop fort... ils ont entendu. Le cadenas, VITE !",
	["My hands won't do it. A crowbar, a claw hammer... anything."] = "Mes mains n'y arriveront pas. Un pied-de-biche, un marteau... n'importe quoi.",
	["Heavy... and loud. I need to be careful."] = "Lourd... et bruyant. Je dois faire attention.",
	["It's nailed shut from the outside."] = "C'est cloué de l'extérieur.",
	["It's locked."] = "C'est verrouillé.",
	["It's locked. The Butcher has the keys."] = "C'est verrouillé. Le Boucher a les clés.",
	["It won't budge."] = "Ça ne bouge pas.",
	["A heavy padlock. Something's knocking underneath. I need something to cut it."] = "Un gros cadenas. Quelque chose frappe en dessous. Il me faut de quoi le couper.",
	["It's open. There's a ladder... and someone breathing down there."] = "C'est ouvert. Il y a une échelle... et quelqu'un respire là-dessous.",
	["Something is coming down the ladder..."] = "Quelque chose descend l'échelle...",
	["...please... please get me out..."] = "...s'il vous plaît... sortez-moi de là...",
	["...please... the chains... find something to cut them..."] = "...s'il vous plaît... les chaînes... trouvez de quoi les couper...",
	["His wrists are chained to the pipe. I need something to cut them."] = "Ses poignets sont enchaînés au tuyau. Il me faut de quoi les couper.",
	["You came back for me... I'm Tom Ellis, the ranger. Get me out of this house and I'll bring help."] = "Tu es revenu me chercher... Je suis Tom Ellis, le garde forestier. Sors-moi de cette maison et je ramènerai de l'aide.",
	["...you came back for me? I can walk. I'll make for the highway and flag down anyone I can. Go!"] = "...tu es revenu me chercher ? Je peux marcher. Je vais rejoindre la grande route et arrêter qui je peux. Va !",
	["I know these woods better than they do. I'll get to the highway and bring the state police. Go, get to the ranger station!"] = "Je connais ces bois mieux qu'eux. Je rejoins la grande route et je ramène la police d'État. Va, cours au poste des gardes !",
	["Tom Ellis is going for help."] = "Tom Ellis part chercher de l'aide.",
	["The back door just crashed in... they're inside the house."] = "La porte de derrière vient de céder... ils sont dans la maison.",
	["I'm out! There was an old pickup in a clearing up the logging road... if it still runs, that's my way out."] = "Je suis dehors ! Il y avait un vieux pick-up dans une clairière en haut du chemin forestier... s'il roule encore, c'est ma sortie.",
	["A truck… out here? Maybe it still runs."] = "Un pick-up… ici ? Il roule peut-être encore.",
	["The engine's gone... battery, plugs, a wheel. And that butcher had keys on his belt."] = "Le moteur a disparu... batterie, bougies, une roue. Et ce boucher avait des clés à sa ceinture.",
	["It won't run. Missing: "] = "Il ne démarre pas. Il manque : ",
	["It's fixed. Now I just need the keys..."] = "Il est réparé. Il ne me manque que les clés...",
	["It's all fixed. Find the keys and drive."] = "Tout est réparé. Trouve les clés et roule.",
	["It sees you coming! Lose it, then sneak up from behind."] = "Il te voit venir ! Sème-le, puis approche-toi par derrière.",
	["Get behind it first."] = "Passe d'abord derrière lui.",
	["You need a sedative syringe."] = "Il te faut une seringue de sédatif.",
	["The keys fell from his belt!"] = "Les clés sont tombées de sa ceinture !",
	["Got them."] = "Je les ai.",
	["Got them. Now get back to the truck before he wakes up."] = "Je les ai. Retourne au pick-up avant qu'il se réveille.",
	["Come on… come on…"] = "Allez… allez…",
	["It's running."] = "Il tourne.",
	["Yes! Okay… let's get out of here."] = "Oui ! Bon… on se tire d'ici.",
	["No, no, no… not now!"] = "Non, non, non… pas maintenant !",
	["IT'S NOT STOPPING!"] = "IL NE S'ARRÊTE PAS !",
	["YOU BROKE MY TRUCK!"] = "TU AS CASSÉ MON PICK-UP !",
	["Drive!"] = "Roule !",
	["RUN!"] = "COURS !",
	["RUN."] = "COURS.",
	["NOW!"] = "MAINTENANT !",
	["It's coming out of the fire... RUN! The ranger station - past the lookout tower!"] = "Il sort du feu... COURS ! Le poste des gardes - après la tour de guet !",
	["Ranger station... no power. The log said the fuse is in the tower, fuel in the shed."] = "Le poste des gardes... pas de courant. Le journal disait : le fusible est dans la tour, l'essence dans la cabane.",
	["The tank is bone dry. I need fuel."] = "Le réservoir est à sec. Il me faut de l'essence.",
	["Generator refueled."] = "Générateur rempli.",
	["A fuse is blown. I need a replacement."] = "Un fusible a sauté. Il m'en faut un autre.",
	["Fuse replaced."] = "Fusible remplacé.",
	["The fuse is in."] = "Le fusible est en place.",
	["No point starting it with a blown fuse."] = "Inutile de le démarrer avec un fusible grillé.",
	["Power's on. They definitely heard that... the radio, now!"] = "Le courant est rétabli. Ils ont forcément entendu... la radio, vite !",
	["The power's on."] = "Le courant est rétabli.",
	["Dead. No power."] = "Mort. Pas de courant.",
	["Dead. Just breathing."] = "Rien. Juste une respiration.",
	["Mayday, mayday! Is anyone there?"] = "Mayday, mayday ! Il y a quelqu'un ?",
	["…Pinecrest dispatch… copy… what's your location?"] = "…central de Pinecrest… reçu… quelle est votre position ?",
	["The ranger station off Hollow Road! They're… they're eating people!"] = "Le poste des gardes sur Hollow Road ! Ils… ils mangent les gens !",
	["…rescue chopper inbound, two minutes. Hold on. Barricade yourself in."] = "…hélicoptère de secours en route, deux minutes. Tenez bon. Barricadez-vous.",
	["...two minutes is a long time, little guest. We heard every word."] = "...deux minutes, c'est long, petit invité. On a tout entendu.",
	["*gasping* Come on, come on...!"] = "*haletant* Allez, allez...!",
	["Lock- lock it, LOCK IT!"] = "Ferme- ferme-la, FERME-LA !",
	["...please hold... please hold..."] = "...tiens bon... tiens bon...",
	["...it stopped. It's waiting."] = "...ça s'est arrêté. Il attend.",
	["(whispering) ...open the door. We just want to talk."] = "(en chuchotant) ...ouvre la porte. On veut juste parler.",
	["Little guest, little guest... let me come in."] = "Petit invité, petit invité... laisse-moi entrer.",
	["...no. No no no."] = "...non. Non non non.",
	["RUN- hide- just MOVE!"] = "COURS- cache-toi- BOUGE !",
	["THE DOOR! It's coming through the door!"] = "LA PORTE ! Il passe par la porte !",
	["Pinecrest Rescue on station! Get to the pad, NOW!"] = "Secours de Pinecrest sur place ! À l'hélipad, VITE !",
	["Hold on to something. Next stop, Pinecrest General."] = "Accroche-toi. Prochain arrêt, l'hôpital de Pinecrest.",
	["We're hit! Tail rotor's gone - BRACE! BRACE!"] = "On est touchés ! Plus de rotor de queue - ACCROCHEZ-VOUS !",
	["...everyone okay? Where's the pilot?"] = "...tout le monde va bien ? Où est le pilote ?",
	["The pilot's seat is empty. Belt cut. Blood on the door... and drag marks, heading south."] = "Le siège du pilote est vide. Ceinture coupée. Du sang sur la porte... et des traces, vers le sud.",
	["HOLLOW MEATS. The plant from the photos... the trail goes right inside."] = "HOLLOW MEATS. L'usine des photos... les traces vont droit à l'intérieur.",
	["Cold storage. The lock is electric - no power, no way in."] = "La chambre froide. La serrure est électrique - pas de courant, pas d'entrée.",
	["A steel door marked MINE ACCESS - AUTHORISED ONLY. There's a card reader."] = "Une porte en acier : ACCÈS MINE - PERSONNEL AUTORISÉ. Il y a un lecteur de badge.",
	["The mine. The letter said the tunnels run all the way to town."] = "La mine. La lettre disait que les tunnels vont jusqu'à la ville.",
	["Rails. They hauled the coal out this way... and other things."] = "Des rails. Ils sortaient le charbon par ici... et d'autres choses.",
	["Light up ahead - stairs. GO!"] = "De la lumière devant - des escaliers. VAS-Y !",
	["A crypt... under a church. We're in Pinecrest."] = "Une crypte... sous une église. On est à Pinecrest.",
	["An iron gate across the crypt stairs, padlocked. One of the coffins might have the key."] = "Une grille en fer bloque l'escalier de la crypte, cadenassée. Un des cercueils a peut-être la clé.",
	["The gate key. Quietly now."] = "La clé de la grille. Doucement maintenant.",
	["Every cop in the county will hear that. So will they."] = "Tous les flics du comté vont entendre ça. Eux aussi.",
	["It's still ringing in your ears."] = "Ça résonne encore dans tes oreilles.",
	["STATE POLICE! Anyone out there - to the car, NOW!"] = "POLICE D'ÉTAT ! Si quelqu'un est là - à la voiture, VITE !",
	["The pilot flagged us down on the highway. And a ranger - Ellis - walked out of the woods an hour ago."] = "Le pilote nous a arrêtés sur la grande route. Et un garde - Ellis - est sorti des bois il y a une heure.",
	["You're safe now. You're safe. What in God's name happened out there?"] = "Vous êtes en sécurité. En sécurité. Qu'est-ce qui s'est passé là-bas, bon sang ?",
	["We made it... we actually made it out."] = "On a réussi... on s'en est vraiment sortis.",
	["Everyone made it. Everyone."] = "Tout le monde s'en est sorti. Tout le monde.",
	["Everyone made it out. Ranger Ellis, the pilot, you. Nobody left behind."] = "Tout le monde s'en est sorti. Le garde Ellis, le pilote, toi. Personne n'est resté derrière.",
	["Almost home."] = "Presque à la maison.",
	["Keep going."] = "Continue.",
	["Stay close. Don't lose the light."] = "Reste près de moi. Ne perds pas la lumière.",
	["…they are still hungry."] = "…ils ont encore faim.",
	["<i>...they are still hungry.</i>"] = "<i>...ils ont encore faim.</i>",
	["They're still hungry."] = "Ils ont encore faim.",
	["...dinner's almost ready..."] = "...le dîner est presque prêt...",
	["...supper's on the table..."] = "...le souper est servi...",
	["...there's always room at the table..."] = "...il y a toujours de la place à table...",
	["...and then there's always room for more."] = "...et il y a toujours de la place pour un de plus.",
	["...don't eat the stew..."] = "...ne mange pas le ragoût...",
	["...don't run. Running makes the meat tough..."] = "...ne cours pas. Courir rend la viande dure...",
	["...we can smell you..."] = "...on te sent...",
	["…we can smell the city on you…"] = "…on sent la ville sur toi…",
	["...we found your friends..."] = "...on a trouvé tes amis...",
	["...behind you..."] = "...derrière toi...",
	["...is someone up there...?"] = "...il y a quelqu'un là-haut...?",
	["...they're coming back... hide..."] = "...ils reviennent... cache-toi...",
	["...Michel... it's in here..."] = "...Michel... c'est là-dedans...",
	["(whispering) Mama's going to be so pleased."] = "(en chuchotant) Maman va être tellement contente.",
	["...don't stop. Whatever you do, don't stop the car."] = "...ne t'arrête pas. Quoi qu'il arrive, n'arrête pas la voiture.",
	["...hold on, we're inbound..."] = "...tenez bon, on arrive...",
	["Nothing else worth taking."] = "Plus rien qui vaille la peine d'être pris.",
	["No. I'm not touching that again."] = "Non. Je ne touche plus à ça.",
	["Already thrown."] = "Déjà lancé.",
	["That's everything. Time to go."] = "C'est tout. Il est temps de partir.",
	["The drawer. The hatch. Everything."] = "Le tiroir. La trappe. Tout.",
	["…All of it?"] = "…Tout ?",
	["Something's stuck behind the glass. Is that… a tooth?"] = "Quelque chose est coincé derrière la vitre. C'est… une dent ?",
	["Someone dropped what they were carrying. It's still out there."] = "Quelqu'un a lâché ce qu'il portait. C'est toujours là-bas.",
	["The woods are growing..."] = "Les bois grandissent...",
	["The intended scare."] = "La frayeur prévue.",

